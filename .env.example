# Copy to .env or .env.local and fill in your values.
# Do not put real secrets in this file or commit them to git.
# Vite exposes VITE_* (and LAUNDRY_* via vite.config.mjs envPrefix).

# --- Required: backend API (trailing slash required) ---
# DEV: omit this (or set a loopback URL) to use the Vite same-origin /api proxy.
# Do not leave this empty in a production build — there is no hosted fallback.
# Examples: https://stagelaundry.sigisolutions.net/ | http://localhost:8083/
VITE_API_BASE_URL=https://your-api.example.com/
# Backward-compatible alias:
# LAUNDRY_API_BASE_URL=https://your-api.example.com/

# --- Required: Google Maps JavaScript API (browser key) ---
# Never put a real key in this file. Copy to .env / .env.local and restart Vite.
# Geocoding REST is server-side (GOOGLE_MAPS_KEY on the API). Do not call
# maps.googleapis.com/maps/api/geocode from the browser.
VITE_GOOGLE_MAPS_KEY=your-google-maps-browser-key
# Backward-compatible alias:
# LAUNDRY_GOOGLE_MAPS_KEY=your-google-maps-browser-key
#
# If the Edit zone map shows AuthFailure / InvalidKey / “can't load Google Maps”:
# 1. Google Cloud Console → APIs & Services → Library → enable
#    Maps JavaScript API (includes the Drawing library) and Places API.
# 2. Enable billing on that Cloud project.
# 3. Credentials → browser key → HTTP referrers must include:
#    http://localhost:5174/*   http://127.0.0.1:5174/*   http://<LAN-IP>:5174/*
# 4. API restrictions must allow Maps JavaScript API and Places API.

# --- Gemini (AI blog description) ---
# Set GEMINI_API_KEY (or LAUNDRY_GEMINI_API_KEY) on the API host, not here.
# Vite env is bundled into the SPA and would be visible to every admin user.

# --- Required for FCM: Firebase web app + Web Push VAPID ---
# Firebase Console → Project settings → Your apps → Web app config
# VAPID: Project settings → Cloud Messaging → Web Push certificates
# sync:fcm-sw runs automatically before npm run dev / npm run build
# (writes public/firebase-messaging-sw.js).
#
# Local development disables FCM if these are unset. Production builds require
# every VITE_FIREBASE_* value below and fail fast when configuration is missing.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key
#
# Backward-compatible aliases: LAUNDRY_FIREBASE_API_KEY, LAUNDRY_FIREBASE_AUTH_DOMAIN,
# LAUNDRY_FIREBASE_PROJECT_ID, LAUNDRY_FIREBASE_STORAGE_BUCKET,
# LAUNDRY_FIREBASE_MESSAGING_SENDER_ID, LAUNDRY_FIREBASE_APP_ID,
# LAUNDRY_FIREBASE_VAPID_KEY
# Optional alias: VITE_FIREBASE_MESSAGING_VAPID_KEY
