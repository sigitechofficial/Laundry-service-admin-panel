# Copy to .env or .env.local and fill in your values.

# Backend API base URL (trailing slash required)
# Stage:
LAUNDRY_API_BASE_URL=https://stagelaundry.sigisolutions.net/
# Prod:
# LAUNDRY_API_BASE_URL=https://prodlaundry.sigisolutions.net/
# Local:
# LAUNDRY_API_BASE_URL=http://localhost:8083/

# For local frontend testing of AI blog description (Gemini).
# Get your key: https://aistudio.google.com/apikey

LAUNDRY_GEMINI_API_KEY=AIzaSyBSbj3Zr7kHpIGUaL9LX3uwqexpc-2SnNw

# Optional: if "model not found" or quota errors, set model from list:
# GET https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY
# Use the model name without "models/" (e.g. gemini-1.5-flash-001 or gemini-2.0-flash)
# LAUNDRY_GEMINI_MODEL=gemini-1.5-flash-001

# Firebase Cloud Messaging — admin login sends dvToken (see firebase-dvtokken.md)
# Prefer VITE_FIREBASE_* (standard) or use LAUNDRY_FIREBASE_* — both work.
# Web Push VAPID: Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
# sync:fcm-sw runs automatically before npm run dev / npm run build (writes public/firebase-messaging-sw.js).
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_VAPID_KEY=
#
# Example project shape (laundry-app-bf43c): copy your own keys from Firebase Console → Web app config.
# storageBucket is often <projectId>.appspot.com (check your console).
