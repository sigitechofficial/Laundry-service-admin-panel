{
  "name": "laundryadmin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run sync:fcm-sw && npm run write:release",
    "dev": "npx vite --host --port 5174",
    "prebuild": "npm run sync:fcm-sw && npm run write:release",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview --port 2424",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/sessionAndApiErrors.test.mjs",
    "lint": "eslint src",
    "tunnel": "npx ngrok http 5174",
    "tunnel:localtunnel": "npx localtunnel --port 2424",
    "tunnel:cloudflare": "npx cloudflared tunnel --url http://localhost:2424",
    "sync:fcm-sw": "node scripts/sync-fcm-service-worker.mjs",
    "write:release": "node scripts/write-release-info.mjs",
    "check-env": "node scripts/check-env.js",
    "setup-api-key": "node scripts/setup-google-maps-key.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.0",
    "@react-google-maps/api": "^2.20.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.91.0",
    "@tiptap/extension-image": "^2.10.2",
    "@tiptap/extension-link": "^2.10.2",
    "@tiptap/extension-placeholder": "^2.10.2",
    "@tiptap/pm": "^2.10.2",
    "@tiptap/react": "^2.10.2",
    "@tiptap/starter-kit": "^2.10.2",
    "@types/uuid": "^10.0.0",
    "chart.js": "^4.4.0",
    "critters": "^0.0.23",
    "dayjs": "^1.11.19",
    "firebase": "^11.9.1",
    "framer-motion": "^12.27.1",
    "libphonenumber-js": "^1.12.9",
    "marked": "^17.0.5",
    "notistack": "^3.0.1",
    "react": "18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.50.0",
    "react-icons": "^5.5.0",
    "react-phone-input-2": "^2.15.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.2",
    "uuid": "^13.0.0",
    "yup": "^1.4.0",
    "zod": "^4.1.13",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.0",
    "vite": "^7.3.1"
  }
}
